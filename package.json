{
  "name": "otonari-tenshi-crawler",
  "version": "1.0.0",
  "description": "Crawler tool for otonaritenshi.wordpress.com - crawl light novel content and generate EPUB",
  "main": "crawl.js",
  "scripts": {
    "crawl": "node crawl.js",
    "epub": "node crawl.js --epub-only",
    "import-pdf": "node import-pdf.js",
    "build-data": "node build-data.js",
    "build-characters": "node scripts/build-character-catalog.js",
    "vendor-ebook-reader": "node scripts/vendor-ebook-reader.js",
    "vendor-hand-camera": "node scripts/vendor-hand-camera.js",
    "vendor-sync": "node scripts/vendor-sync.js",
    "vendor-pdf-reader": "node scripts/vendor-pdf-reader.js",
    "start": "node server.js",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "check-data": "node scripts/check-data.js",
    "test:e2e": "node test/e2e/smoke.js",
    "check": "npm run lint && npm test && npm run check-data"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "@supabase/supabase-js": "2.118.0",
    "axios": "^1.7.0",
    "cheerio": "^1.0.0",
    "docx": "^9.6.1",
    "epub-gen-memory": "^1.1.1",
    "express": "^4.22.1",
    "jszip": "^3.10.1",
    "pdfjs-dist": "6.3.289",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.11",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1"
  },
  "engines": {
    "node": ">=22"
  }
}
